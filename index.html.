const PL=[["تقليل النفايات (كغ أسبوعيًا)",20],["إعادة التدوير (كغ شهريًا)",50],["ساعات إطفاء الأضواء (أسبوعيًا)",30],["نباتات محلية مزروعة",15],["حملات توعية منفذة",6]];
