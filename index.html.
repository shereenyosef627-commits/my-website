const GI=[["غابة وأنهار","0% 100%"],["سحب وجبال","10% 0%"],["شلال وصخور","50% 100%"],["شمس وغيوم","100% 0%"],["أشجار الصنوبر","100% 70%"],["ضفة النهر","40% 100%"]];
