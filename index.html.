$("#sn").onclick=e=>{on=!on;e.target.setAttribute("aria-pressed",on);e.target.textContent=on?"الصوت: يعمل":"الصوت: مُطفأ";
try{if(!ac){ac=new (window.AudioContext||window.webkitAudioContext)();const n=ac.createBuffer(1,ac.sampleRate*2,ac.sampleRate),d=n.getChannelData(0);let l=0;for(let i=0;i<d.length;i++){l=(l+.02*(Math.random()*2-1))/1.02;d[i]=l*3.5}
const s=ac.createBufferSource();s.buffer=n;s.loop=true;const f=ac.createBiquadFilter();f.type="lowpass";f.frequency.value=700;gn=ac.createGain();gn.gain.value=0;s.connect(f);f.connect(gn);gn.connect(ac.destination);s.start()}
