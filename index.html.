const P=Array.from({length:26},()=>({x:Math.random(),y:Math.random(),s:3+Math.random()*5,v:.0006+Math.random()*.0012,r:Math.random()*6}));
(function f(t){x.clearRect(0,0,W,H);if(!document.body.classList.contains("reduce")&&!matchMedia("(prefers-reduced-motion:reduce)").matches)P.forEach(p=>{p.y+=p.v;p.x+=Math.sin(t/1500+p.r)*.0004-.0003;if(p.y>1){p.y=-.05;p.x=Math.random()}x.save();x.translate(p.x*W+mx*40,p.y*H);x.rotate(t/900+p.r);x.fillStyle="rgba(150,210,90,.75)";x.beginPath();x.ellipse(0,0,p.s,p.s/2.2,0,0,6.3);x.fill();x.restore()});requestAnimationFrame(f)})(0);
